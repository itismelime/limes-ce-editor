# Keep other .github/ content (Copilot instructions, local hooks) untracked,
# but CI workflows must be tracked to actually run on GitHub Actions.
.github/*
!.github/workflows/

src-tauri/target/*

# Tauri release bundle outputs
src-tauri/target/release/bundle/

# Environment variables (may contain secrets)
.env
.env.*
!.env.example

# OS files
Thumbs.db

# Test coverage
coverage/

# TypeScript build cache
*.tsbuildinfo

# App runtime temp folder
.tmp/

# User-generated category override exports
*-overrides.json

# Bundled map assets (generated via `npm run prepare-maps`, not committed due to large size)
# Overview PNGs (~5-15 MB each) -- these live nested per-map (maps/<id>/map.png),
# a single '*' doesn't match across that directory level.
src-tauri/resources/maps/**/*.png
# Detail tile tree — all zoom levels per map (~1-4 GB total for all 4 maps)
src-tauri/resources/maps/**/*.webp
src-tauri/test*